# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/sculptor_cad

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Email
